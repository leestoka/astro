---
const platform = "github";
const username = "withastro";
import Social from "./Social.astro";
---
<style>
      footer {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 2rem;
      }
      .socials {
            display: flex;
            gap: 1rem;
      }
      .credit {
            font-size: 0.875rem;
      }
      .credit a {
            color: inherit;
      }
</style>
<footer>
      <div class="socials">
            <Social platform="twitter" username="leestoka" />
            <Social platform="github" username="leestoka" />
            <Social platform="youtube" username="leestoka" />
      </div>
      <p class="credit">Website Design by <a href="https://digitalden.com.au/web-design-and-development/">Digital Den</a></p>
</footer>